# Variables de entorno para el frontend React (Vite)
# Copiar este archivo como .env.local en el repo del frontend

# URL base de la API Gateway (obtenida del output de cdk deploy)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Cognito User Pool ID (obtenido del output de cdk deploy)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx

# Cognito App Client ID (obtenido del output de cdk deploy)
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Región de AWS
VITE_AWS_REGION=us-east-1
